{
  "schemaVersion": "prometheus-skill-bundle-v1",
  "id": "pr-review-toolkit",
  "name": "PR Review Toolkit",
  "description": "Run a focused pull-request review through specialized lenses for code correctness, tests, comments, silent failures, type design, and simplification. Use when the user explicitly requests a deep PR review or selected review aspects.",
  "version": "1.0.0",
  "entrypoint": "SKILL.md",
  "triggers": [
    "review this pr with all lenses",
    "run a deep pr review",
    "run the pr review toolkit",
    "review the type design",
    "simplify this pull request",
    "hunt silent failures",
    "review pr comments",
    "analyze pr tests"
  ],
  "promptSignals": {
    "phrases": [
      "run a deep pr review",
      "review this pr with all lenses",
      "analyze pr tests",
      "hunt silent failures",
      "review the type design",
      "review pr comments",
      "run the pr review toolkit"
    ],
    "allOf": [
      [
        "deep",
        "pr",
        "review"
      ],
      [
        "pr",
        "review",
        "tests"
      ],
      [
        "silent",
        "failures"
      ],
      [
        "type",
        "design"
      ],
      [
        "pr",
        "comments"
      ],
      [
        "simplify",
        "pull",
        "request"
      ],
      [
        "review",
        "all",
        "lenses"
      ]
    ],
    "anyOf": [
      "pr review toolkit",
      "silent failures",
      "type design",
      "pr tests",
      "pr comments",
      "simplify pull request",
      "review lenses"
    ],
    "noneOf": [
      "review one function",
      "unit test only",
      "write a pr description",
      "create a pull request"
    ],
    "minScore": 6
  },
  "categories": [
    "review",
    "pull-request",
    "quality",
    "testing"
  ],
  "requiredTools": [
    "workspace_write",
    "agents_and_teams"
  ],
  "implicitInvocation": false,
  "permissions": {
    "workspaceRead": true,
    "workspaceWrite": false,
    "shell": true,
    "externalSideEffects": false
  },
  "resources": []
}
