{
  "schemaVersion": "prometheus-skill-bundle-v1",
  "id": "ghostwriter",
  "name": "ghostwriter",
  "description": "Draft publishable content in a specific person or brand voice from supplied samples, facts, intent, and boundaries. Use when voice fidelity is central; do not use to impersonate someone deceptively, invent personal experience, or replace a specialized legal/financial workflow.",
  "visibility": "public",
  "version": "1.1.0",
  "entrypoint": "SKILL.md",
  "triggers": [
    "make this sound like me",
    "make this less ai",
    "write in my voice",
    "rewrite for clarity",
    "rewrite this copy",
    "improve the tone",
    "polish this writing",
    "write an article",
    "write a script",
    "draft a post",
    "write a bio",
    "ghostwrite this"
  ],
  "categories": [],
  "requiredTools": [],
  "implicitInvocation": true,
  "permissions": {},
  "resources": [
    {
      "path": "references/detailed-guide.md",
      "type": "reference"
    },
    {
      "path": "references/workflows/ghostwriter.md",
      "type": "doc",
      "description": "Add workflow recipe to ghostwriter"
    }
  ],
  "triggerPolicy": {
    "version": 2,
    "rules": [
      {
        "allOf": [
          "in my voice"
        ]
      },
      {
        "allOf": [
          "ghostwrite"
        ]
      },
      {
        "allOf": [
          "voice"
        ],
        "anyOf": [
          "brand voice",
          "sound like me",
          "in his voice",
          "in her voice"
        ]
      }
    ]
  }
}
