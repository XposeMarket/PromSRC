{
  "schemaVersion": "prometheus-skill-bundle-v1",
  "entrypoint": "SKILL.md",
  "visibility": "public",
  "description": "Research a market, customer segment, category, demand pattern, trend, or opportunity using current sourced evidence and explicit assumptions. Use for market-level questions; use competitor-profile for one company and social-intel for platform/account-specific research.",
  "triggers": [
    "customer pain points",
    "research this market",
    "buyer persona research",
    "tam sam som",
    "market opportunity",
    "industry landscape",
    "category analysis",
    "customer segment",
    "industry trends",
    "market research",
    "trend analysis",
    "go-to-market research"
  ],
  "categories": [
    "research",
    "business",
    "strategy"
  ],
  "requiredTools": [
    "web_search",
    "web_fetch"
  ],
  "lifecycle": "active",
  "id": "market-research",
  "name": "market-research",
  "implicitInvocation": true,
  "triggerPolicy": {
    "version": 2,
    "rules": [
      {
        "allOf": [
          "market"
        ],
        "anyOf": [
          "research",
          "size",
          "sizing",
          "tam",
          "segment",
          "demand"
        ],
        "noneOf": [
          "stock market",
          "farmers market"
        ]
      },
      {
        "allOf": [
          "segment"
        ],
        "anyOf": [
          "demand",
          "customers",
          "size"
        ],
        "noneOf": [
          "stock market",
          "farmers market",
          "video segment"
        ]
      }
    ]
  }
}
