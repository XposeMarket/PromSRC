{
  "schemaVersion": "prometheus-skill-bundle-v1",
  "entrypoint": "SKILL.md",
  "visibility": "public",
  "description": "Build or review a structured financial forecast, budget, scenario model, unit-economics model, pricing model, or cash plan. Use when the deliverable is a model with linked assumptions and outputs; use financial-analyst for interpreting existing performance.",
  "triggers": [
    "build a financial model",
    "cash flow projection",
    "unit economics model",
    "financial projection",
    "sensitivity analysis",
    "scenario analysis",
    "spreadsheet model",
    "model assumptions",
    "forecast revenue",
    "expense forecast",
    "break-even model",
    "sales forecast"
  ],
  "categories": [
    "finance",
    "spreadsheets",
    "modeling",
    "business"
  ],
  "requiredTools": [
    "workspace_write",
    "show_ui_card"
  ],
  "lifecycle": "active",
  "name": "financial-model",
  "id": "financial-model",
  "implicitInvocation": true,
  "triggerPolicy": {
    "version": 2,
    "rules": [
      {
        "allOf": [
          "financial model"
        ]
      },
      {
        "allOf": [
          "forecast"
        ],
        "anyOf": [
          "revenue",
          "budget",
          "scenario",
          "3 year",
          "p&l"
        ]
      },
      {
        "allOf": [
          "budget"
        ],
        "anyOf": [
          "build",
          "model",
          "scenario"
        ]
      }
    ]
  }
}
