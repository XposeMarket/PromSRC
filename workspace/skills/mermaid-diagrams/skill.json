{
  "schemaVersion": "prometheus-skill-bundle-v1",
  "id": "mermaid-diagrams",
  "name": "mermaid-diagrams",
  "description": "Create or edit a Mermaid flowchart, sequence diagram, state diagram, ERD, class diagram, timeline, or other text-native diagram. Use only when Mermaid is explicitly requested or already used in the target document; use SVG for bespoke visual composition.",
  "version": "1.0.0",
  "entrypoint": "SKILL.md",
  "triggers": [
    "diagram this process",
    "draw the workflow",
    "architecture diagram",
    "visualize architecture",
    "dependency diagram",
    "sequence diagram",
    "markdown diagram",
    "mermaid diagram",
    "render mermaid",
    "state diagram",
    "class diagram",
    "journey map"
  ],
  "categories": [
    "visualization",
    "diagrams",
    "documentation"
  ],
  "requiredTools": [
    "creative_basic",
    "workspace_write"
  ],
  "implicitInvocation": false,
  "permissions": {
    "workspaceRead": true,
    "workspaceWrite": true,
    "shell": false,
    "externalSideEffects": false
  },
  "resources": [
    {
      "path": "references/detailed-guide.md",
      "type": "reference"
    }
  ]
}
