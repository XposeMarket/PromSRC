{
  "schemaVersion": "prometheus-skill-bundle-v1",
  "id": "first-customer-finder",
  "name": "first-customer-finder",
  "description": "Find and qualify evidence-backed first customers or design partners from recent public pain and buying signals. Use for an offer-to-prospect shortlist and shareable report; use local-lead-hunting for Maps-first local business discovery and cold-outreach-writer for message-level drafting.",
  "version": "1.0.0",
  "entrypoint": "SKILL.md",
  "triggers": [
    "first users for my product",
    "find my first customers",
    "find first agency clients",
    "source backed prospect report",
    "first customer prospects",
    "find design partners",
    "early adopter shortlist",
    "qualify potential customers"
  ],
  "promptSignals": {
    "phrases": [
      "first customers",
      "design partners",
      "early adopters",
      "potential first clients",
      "first buyer prospects"
    ],
    "allOf": [],
    "anyOf": [
      "first customer",
      "design partner",
      "early adopter",
      "initial clients"
    ],
    "noneOf": [
      "send outreach",
      "write cold email",
      "google maps business leads"
    ],
    "minScore": 4
  },
  "categories": [
    "sales",
    "lead-generation",
    "customer-discovery",
    "startups",
    "research",
    "prospecting"
  ],
  "requiredTools": [
    "web_search",
    "web_fetch",
    "workspace_write"
  ],
  "implicitInvocation": true,
  "permissions": {
    "workspaceRead": true,
    "workspaceWrite": true,
    "shell": false,
    "externalSideEffects": false
  },
  "resources": [
    {
      "path": "agents/openai.yaml",
      "type": "reference"
    },
    {
      "path": "references/report-artifact.md",
      "type": "reference"
    },
    {
      "path": "references/research-framework.md",
      "type": "reference"
    },
    {
      "path": "scripts/generate_report.py",
      "type": "script"
    }
  ]
}
