{
  "schemaVersion": "prometheus-skill-bundle-v1",
  "id": "competitor-profile",
  "name": "competitor-profile",
  "description": "Create or update a sourced profile of one named competitor covering facts, product, pricing, positioning, customers, distribution, evidence, changes, strengths, and weaknesses. Use for a single-company dossier; use competitive-intelligence for cross-competitor synthesis.",
  "version": "1.0.0",
  "entrypoint": "SKILL.md",
  "triggers": [
    "create a dossier for this competitor",
    "one time competitor profile",
    "profile this competitor",
    "competitor pricing notes",
    "competitor strengths weaknesses",
    "analyze one competitor",
    "research this company",
    "update competitor file",
    "competitor positioning",
    "competitor evidence",
    "competitor profile",
    "competitor dossier"
  ],
  "categories": [
    "research",
    "competitive-intelligence",
    "profiles"
  ],
  "requiredTools": [
    "web_search",
    "web_fetch",
    "workspace_write"
  ],
  "implicitInvocation": true,
  "permissions": {
    "workspaceRead": true,
    "workspaceWrite": true,
    "shell": false,
    "externalSideEffects": false
  },
  "resources": [
    {
      "path": "references/detailed-guide.md",
      "type": "reference"
    }
  ]
}
