{
  "schemaVersion": "prometheus-skill-bundle-v1",
  "id": "verification",
  "name": "Full-Story Verification",
  "description": "Verify a complete user story end to end across UI, client/server code, APIs, processes, data, external dependencies, and the final response. Use when the user asks whether a feature actually works or wants full-flow proof; do not use for unit-test-only requests.",
  "version": "1.1.0",
  "entrypoint": "SKILL.md",
  "triggers": [
    "verify the ui to api flow",
    "verify this end to end",
    "test the complete user story",
    "run a full flow test",
    "make sure the feature works",
    "prove that it is fixed",
    "verify the whole flow",
    "does this actually work",
    "is it actually fixed",
    "check everything works",
    "prove it works"
  ],
  "promptSignals": {
    "phrases": [
      "verify this end to end",
      "verify the whole flow",
      "test the complete user story",
      "does this actually work",
      "check everything works",
      "run a full flow test",
      "make sure the feature works",
      "actually fixed",
      "prove it",
      "prove it works",
      "is it really fixed",
      "did it actually work"
    ],
    "allOf": [
      [
        "verify",
        "flow"
      ],
      [
        "verify",
        "works"
      ],
      [
        "check",
        "everything"
      ],
      [
        "test",
        "complete"
      ],
      [
        "test",
        "end"
      ],
      [
        "make",
        "sure",
        "works"
      ],
      [
        "ui",
        "api",
        "flow"
      ]
    ],
    "anyOf": [
      "verification",
      "end to end",
      "full flow",
      "complete flow",
      "actually work",
      "working",
      "user story"
    ],
    "noneOf": [
      "unit test",
      "jest",
      "vitest",
      "playwright test",
      "cypress test",
      "write a test",
      "test helper"
    ],
    "minScore": 6
  },
  "categories": [
    "verification",
    "qa",
    "browser-testing",
    "development"
  ],
  "requiredTools": [
    "workspace_write",
    "browser_automation"
  ],
  "implicitInvocation": true,
  "permissions": {
    "workspaceRead": true,
    "workspaceWrite": false,
    "shell": true,
    "browser": true,
    "externalSideEffects": false
  },
  "resources": []
}
