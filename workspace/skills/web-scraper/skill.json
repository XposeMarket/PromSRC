{
  "schemaVersion": "prometheus-skill-bundle-v1",
  "id": "web-scraper",
  "name": "web-scraper",
  "description": "Search, fetch, read, scrape, or extract information from websites with Prometheus-native web and browser tools. Use for web research, source collection, full-page extraction, repeated listings, JavaScript-rendered pages, infinite scrolling, structured DOM data, or clean summaries derived from extracted content.",
  "version": "1.0.0",
  "entrypoint": "SKILL.md",
  "triggers": [
    "collect listings from this page",
    "scroll and collect this page",
    "search and fetch sources",
    "extract this full page",
    "read this javascript page",
    "fetch these web pages",
    "extract structured website data",
    "scrape this site"
  ],
  "categories": [
    "web",
    "research",
    "browser",
    "extraction"
  ],
  "requiredTools": [
    "web_search",
    "web_fetch",
    "browser_automation"
  ],
  "implicitInvocation": true,
  "permissions": {
    "workspaceRead": true,
    "workspaceWrite": true,
    "shell": false,
    "externalSideEffects": false
  },
  "resources": [
    {
      "path": "references/detailed-guide.md",
      "type": "reference"
    }
  ]
}
