{
  "schemaVersion": "prometheus-skill-bundle-v1",
  "id": "delivery-and-artifact-verification",
  "name": "delivery-and-artifact-verification",
  "description": "Deliver and verify an actual generated file, screenshot, report, or attachment through the requested channel. Use for presentation and receipt; not for finding old artifacts (artifact-registry).",
  "visibility": "public",
  "version": "1.0.0",
  "entrypoint": "SKILL.md",
  "triggers": [
    "verify the attachment arrived",
    "send the generated file"
  ],
  "categories": [],
  "requiredTools": [
    "delivery_send"
  ],
  "implicitInvocation": true,
  "permissions": {
    "workspaceRead": true,
    "workspaceWrite": false,
    "externalSideEffects": false
  },
  "resources": [],
  "triggerPolicy": {
    "version": 2,
    "rules": [
      {
        "allOf": [
          "send"
        ],
        "anyOf": [
          "the file",
          "the report",
          "screenshot",
          "attachment"
        ],
        "noneOf": [
          "email"
        ]
      },
      {
        "allOf": [
          "deliver"
        ],
        "anyOf": [
          "file",
          "report",
          "attachment"
        ]
      }
    ]
  }
}
