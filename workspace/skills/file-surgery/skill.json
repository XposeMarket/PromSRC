{
  "schemaVersion": "prometheus-skill-bundle-v1",
  "id": "file-surgery",
  "name": "file-surgery",
  "description": "Make precise, evidence-backed edits to workspace files, source files, Markdown, JSON, YAML, and configuration while preserving unrelated user changes. Use for local file modification and patch recovery; use promsrc-pr-worktree for Prometheus source changes.",
  "version": "3.0.0",
  "entrypoint": "SKILL.md",
  "triggers": [
    "clean up this document",
    "verify the file change",
    "make this file change",
    "edit the prompt file",
    "inspect before editing",
    "update workspace docs",
    "update generated docs",
    "rewrite this markdown",
    "modify the markdown",
    "replace these lines",
    "remove a section",
    "change this json"
  ],
  "categories": [],
  "requiredTools": [],
  "implicitInvocation": false,
  "permissions": {},
  "resources": [
    {
      "path": "references/codex-style-engineering-mode.md",
      "type": "doc",
      "description": "Quick Codex-style engineering checklist for code/file edits, verification, repair loops, and final reporting."
    },
    {
      "path": "references/config-surgery.md",
      "type": "reference"
    },
    {
      "path": "references/creative-artifact-presentation.md",
      "type": "reference"
    },
    {
      "path": "references/detailed-guide.md",
      "type": "reference"
    },
    {
      "path": "references/recovery/minified-js-invalid-optional-chaining.md",
      "type": "doc"
    },
    {
      "path": "references/recovery/text-match-failures.md",
      "type": "doc",
      "description": "Add recovery to file-surgery"
    },
    {
      "path": "references/workflows/file-surgery.md",
      "type": "doc",
      "description": "Add workflow recipe to file-surgery"
    },
    {
      "path": "references/workspace-file-tools-not-shell.md",
      "type": "doc",
      "description": "File tool routing, grep no-match, src-edit pointer"
    }
  ]
}
