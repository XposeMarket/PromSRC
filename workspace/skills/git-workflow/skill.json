{
  "schemaVersion": "prometheus-skill-bundle-v1",
  "id": "git-workflow",
  "name": "git-workflow",
  "description": "Inspect and operate Git repositories safely: status, diffs, commits, branches, remotes, conflict recovery, submodules, GitHub CLI, and authenticated publication. Use for concrete Git or GitHub operations, not generic coding.",
  "version": "1.2.0",
  "entrypoint": "SKILL.md",
  "triggers": [
    "preserve dirty work",
    "revert my change",
    "create a branch",
    "check the diff",
    "push to github",
    "sync the repo",
    "make a commit",
    "prepare a commit",
    "commit and push",
    "open a pull request",
    "clean gone branches",
    "resolve conflicts"
  ],
  "categories": [
    "git",
    "github",
    "version-control",
    "repo-operations"
  ],
  "promptSignals": {
    "phrases": [
      "preserve dirty work",
      "revert my change",
      "create a branch",
      "check the diff",
      "push to github",
      "sync the repo",
      "make a commit",
      "prepare a commit",
      "commit and push",
      "open a pull request",
      "clean gone branches",
      "check the git diff",
      "resolve merge conflicts",
      "resolve conflicts",
      "compare branches",
      "preserve my dirty work"
    ],
    "allOf": [
      ["git", "diff"],
      ["git", "commit"],
      ["commit", "push"],
      ["pull", "request"],
      ["merge", "conflict"],
      ["gone", "branch"],
      ["dirty", "work"]
    ],
    "anyOf": ["git", "commit", "branch", "diff", "remote", "push", "pull request", "worktree", "conflict"],
    "noneOf": ["write a git tutorial", "explain what git is", "generate a changelog"],
    "minScore": 4
  },
  "requiredTools": [
    "git_status",
    "git_diff",
    "git_log",
    "git_branch",
    "git_commit",
    "git_push"
  ],
  "permissions": {
    "workspaceRead": true,
    "workspaceWrite": false,
    "externalSideEffects": true
  },
  "resources": [
    {
      "path": "references/github-authentication.md",
      "type": "doc",
      "description": "Guardrail for safely setting up full local GitHub CLI access without leaking tokens."
    }
  ],
  "implicitInvocation": true,
  "lifecycle": "active"
}
