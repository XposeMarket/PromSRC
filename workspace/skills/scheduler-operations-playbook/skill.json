{
  "schemaVersion": "prometheus-skill-bundle-v1",
  "id": "scheduler-operations-playbook",
  "name": "scheduler-operations-playbook",
  "description": "Create, inspect, update, run, diagnose, and verify Prometheus scheduled jobs, including cron/interval timing, ownership, expected outputs, delivery, retries, and run history. Use for scheduler operations; do not use for ordinary foreground tasks or generic background-agent work.",
  "version": "2.1.0",
  "entrypoint": "SKILL.md",
  "triggers": [
    "run scheduled job now",
    "create scheduled job",
    "inspect scheduled job",
    "update scheduled job",
    "resume scheduled job",
    "delete scheduled job",
    "scheduled job status",
    "diagnose scheduled delivery",
    "verify scheduled output",
    "pause scheduled job"
  ],
  "categories": [
    "automation",
    "scheduler",
    "operations",
    "runbook"
  ],
  "requiredTools": [
    "schedule_job",
    "schedule_job_detail",
    "schedule_job_history",
    "schedule_job_log_search",
    "schedule_job_patch",
    "schedule_job_outputs",
    "schedule_job_stuck_control",
    "automation_dashboard",
    "task_control",
    "internal_watch",
    "update_heartbeat"
  ],
  "requires": {
    "tools": [
      "schedule_job",
      "schedule_job_detail",
      "schedule_job_history",
      "schedule_job_log_search",
      "schedule_job_patch",
      "schedule_job_outputs",
      "schedule_job_stuck_control",
      "automation_dashboard",
      "task_control",
      "internal_watch",
      "update_heartbeat",
      "write_note"
    ],
    "toolCategories": [
      "automations"
    ],
    "connectors": [],
    "env": [],
    "bins": [],
    "platforms": [],
    "permissions": []
  },
  "implicitInvocation": true,
  "permissions": {},
  "resources": [
    {
      "path": "examples/confirm-gate-workarounds.md",
      "type": "example"
    },
    {
      "path": "examples/create-job-with-fallbacks.md",
      "type": "example"
    },
    {
      "path": "examples/update-delete-patterns.md",
      "type": "example"
    },
    {
      "path": "references/background/failure-looking-success-results.md",
      "type": "doc",
      "description": "Guardrail for scheduled jobs whose run status says success but final output is a tool/error string or missing report artifact."
    },
    {
      "path": "references/background/managed-team-schedule-idle-or-quota-false-success.md",
      "type": "doc",
      "description": "Guardrail for managed-team scheduled jobs whose cron status succeeds while manager output is idle, a greeting, or embedded provider quota error."
    },
    {
      "path": "references/background/non-vision-scheduled-job-recovery.md",
      "type": "doc",
      "description": "Scheduler recovery note for non-vision model/image-input failures and output verification after model patches."
    },
    {
      "path": "references/background/repeated-no-activity-scheduled-job-failures.md",
      "type": "doc",
      "description": "Guardrail for scheduled jobs repeatedly failing with openai_codex no-activity timeouts."
    },
    {
      "path": "references/detailed-guide.md",
      "type": "reference"
    },
    {
      "path": "references/workflows/scheduler-operations-playbook.md",
      "type": "doc",
      "description": "Add workflow recipe to scheduler-operations-playbook"
    }
  ]
}
