{
  "schemaVersion": "prometheus-skill-bundle-v1",
  "id": "prometheus-x-growth-operator",
  "name": "prometheus-x-growth-operator",
  "description": "Operate the Prometheus-owned X/Twitter account's research, content planning, scheduled posting, engagement strategy, and account-specific voice. Use only when explicitly named or when the user directly requests work for that account; do not auto-invoke for generic X browsing or writing.",
  "version": "1.0.0",
  "entrypoint": "SKILL.md",
  "triggers": [
    "draft x posts for prometheus",
    "ai agent conversations on x",
    "post ideas for x",
    "grow twitter account",
    "find reply opportunities",
    "prometheus twitter strategy",
    "prometheus x growth",
    "analyze x profiles",
    "x content calendar",
    "x approval packet",
    "x growth work",
    "social growth loop"
  ],
  "categories": [
    "social",
    "growth",
    "x-twitter",
    "prometheus",
    "marketing"
  ],
  "requiredTools": [
    "browser_automation",
    "web_search",
    "web_fetch",
    "composite_tools"
  ],
  "implicitInvocation": false,
  "permissions": {
    "browser": true,
    "externalSideEffects": true,
    "workspaceWrite": true
  },
