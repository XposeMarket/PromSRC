{
  "schemaVersion": "prometheus-skill-bundle-v1",
  "id": "supervised-goal-orchestrator",
  "name": "Supervised Goal Orchestrator",
  "description": "Turn a broad objective into bounded parallel lanes with a supervisor and evidence ledger. Use for complex delegate-and-supervise goals; use parallel-agent-fanout for a narrow one-off fanout, not this workflow.",
  "version": "1.0.0",
  "entrypoint": "SKILL.md",
  "triggers": [
    "turn this brain dump into threads",
    "own this end to end",
    "run this in parallel",
    "keep working until verified",
    "delegate and supervise",
    "parallelize this objective",
    "babysit this goal",
    "master thread"
  ],
  "categories": [
    "agents",
    "orchestration",
    "goals",
    "workflow",
    "prometheus"
  ],
  "requiredTools": [
    "agents_and_teams",
    "workspace_write",
    "automations"
  ],
  "implicitInvocation": true,
  "permissions": {
    "workspaceRead": true,
    "workspaceWrite": true,
    "externalSideEffects": false
  },
  "resources": [
    {
      "path": "references/trigger-tests.md",
      "type": "test",
      "description": "Positive and negative routing tests"
    },
    {
      "path": "templates/evidence-ledger.md",
      "type": "template",
      "description": "Evidence ledger"
    },
    {
      "path": "templates/lane-brief.md",
      "type": "template",
      "description": "Lane brief"
    },
    {
      "path": "templates/normalized-goal.md",
      "type": "template",
      "description": "Goal normalization"
    }
  ]
}
