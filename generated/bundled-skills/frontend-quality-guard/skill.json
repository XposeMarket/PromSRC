{
  "schemaVersion": "prometheus-skill-bundle-v1",
  "id": "frontend-quality-guard",
  "name": "frontend-quality-guard",
  "description": "Enforce polished, human-designed frontend quality whenever Prometheus creates, edits, reviews, or repairs any user-facing web interface—even a tiny page, component, prototype, dashboard, tool, game, or one-off HTML file. Use to prevent generic AI-generated visual patterns, preserve the repository’s design language, and require responsive browser verification.",
  "version": "1.0.0",
  "entrypoint": "SKILL.md",
  "triggers": [
    "make a quick html page",
    "make a quick web page",
    "create a web interface",
    "build this frontend",
    "update the frontend",
    "polish this screen",
    "mobile layout bug",
    "remove ai slop",
    "fix the ui",
    "frontend component",
    "responsive layout",
    "visual qa"
  ],
  "categories": [
    "frontend",
    "design",
    "engineering",
    "browser",
    "quality"
  ],
  "requiredTools": [
    "workspace_write",
    "browser_automation"
  ],
  "implicitInvocation": true,
  "permissions": {
    "browser": true,
    "workspaceRead": true,
    "workspaceWrite": true,
    "externalSideEffects": false
  },
  "resources": [
    {
      "path": "assets/templates/plain-html-app/index.html",
      "type": "asset"
    },
    {
      "path": "assets/templates/vite-react-app/index.html",
      "type": "asset"
    },
    {
      "path": "assets/templates/vite-react-app/package.json",
      "type": "asset"
    },
    {
      "path": "assets/templates/vite-react-app/src/styles.css",
      "type": "asset"
    },
    {
      "path": "examples/build-dashboard.md",
      "type": "example"
    },
    {
      "path": "examples/game-or-3d.md",
      "type": "example"
    },
    {
      "path": "examples/post-menu-refactor-dom-guard.md",
      "type": "example"
    },
    {
      "path": "examples/repair-existing-app.md",
      "type": "example"
    },
    {
      "path": "references/domain-patterns.md",
      "type": "reference"
    },
    {
      "path": "references/frontend-principles.md",
      "type": "reference"
    },
    {
      "path": "references/verification-playbook.md",
      "type": "reference"
    },
    {
      "path": "references/visual-quality-rubric.md",
      "type": "reference"
    },
    {
      "path": "scripts/frontend_static_audit.py",
      "type": "script"
    },
    {
      "path": "references/anti-slop-and-visual-evidence.md",
      "type": "doc"
    }
  ]
}
