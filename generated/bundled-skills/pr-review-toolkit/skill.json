{
  "schemaVersion": "prometheus-skill-bundle-v1",
  "id": "pr-review-toolkit",
  "name": "PR Review Toolkit",
  "description": "Run a focused pull-request review through specialized lenses for code correctness, tests, comments, silent failures, type design, and simplification. Use when the user explicitly requests a deep PR review or selected review aspects.",
  "version": "1.0.0",
  "entrypoint": "SKILL.md",
  "triggers": [
    "run a deep PR review",
    "review this PR with all lenses",
    "hunt silent failures",
    "review the type design",
    "review PR comments",
    "simplify this pull request",
    "run the PR review toolkit"
  ],
  "promptSignals": {
    "phrases": ["run a deep PR review", "review this PR with all lenses", "hunt silent failures", "review the type design", "review PR comments", "run the PR review toolkit"],
    "allOf": [["deep", "pr", "review"], ["pr", "review", "tests"], ["silent", "failures"], ["type", "design"], ["pr", "comments"], ["simplify", "pull", "request"], ["review", "all", "lenses"]],
    "anyOf": ["PR review toolkit", "silent failures", "type design", "PR tests", "PR comments", "simplify pull request", "review lenses"],
    "noneOf": ["review one function", "unit test only", "write a PR description", "create a pull request"],
    "minScore": 6
  },
  "categories": ["review", "pull-request", "quality", "testing"],
  "requiredTools": ["workspace", "shell", "agents_and_teams"],
  "permissions": {"workspaceRead": true, "workspaceWrite": false, "shell": true, "externalSideEffects": false},
  "implicitInvocation": false,
  "lifecycle": "active"
}
