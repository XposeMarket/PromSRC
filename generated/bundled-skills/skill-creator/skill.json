{
  "schemaVersion": "prometheus-skill-bundle-v1",
  "id": "skill-creator",
  "name": "skill-creator",
  "description": "Create, revise, review, validate, and benchmark Prometheus skills and bundles, including instructions, resources, manifests, tool contracts, recovery paths, verification, and structured prompt routing. Use for explicit skill-authoring requests.",
  "version": "5.0.0",
  "entrypoint": "SKILL.md",
  "triggers": [
    "create a new skill",
    "update an existing skill",
    "improve this skill",
    "review this skill",
    "recreate this skill",
    "design a workflow skill",
    "write a skill bundle",
    "repair skill metadata",
    "test skill triggers",
    "benchmark a skill",
    "optimize skill description",
    "fix this skill"
  ],
  "promptSignals": {
    "phrases": [
      "create a skill",
      "create a new skill",
      "make a skill",
      "update an existing skill",
      "improve this skill",
      "review this skill",
      "recreate this skill",
      "design a workflow skill",
      "write a skill bundle",
      "repair skill metadata",
      "test skill triggers",
      "benchmark a skill",
      "optimize skill description",
      "skill creator",
      "skill creation",
      "skill authoring",
      "skill lifecycle"
    ],
    "allOf": [
      ["skill", "create"],
      ["skill", "update"],
      ["skill", "improve"],
      ["skill", "review"],
      ["skill", "recreate"],
      ["skill", "design"],
      ["skill", "authoring"],
      ["skill", "metadata"],
      ["skill", "trigger"],
      ["skill", "bundle"],
      ["skill", "benchmark"],
      ["skill", "eval"],
      ["skill", "routing"],
      ["prompt", "signals"],
      ["reusable", "workflow"]
    ],
    "anyOf": [
      "skill",
      "skills",
      "skill.md",
      "skill.json",
      "skill creator",
      "skill creation",
      "skill authoring",
      "skill metadata",
      "skill triggers",
      "skill bundle",
      "skill catalog",
      "skill eval",
      "benchmark",
      "prompt signals",
      "workflow skill",
      "skill review"
    ],
    "noneOf": [
      "use this skill",
      "run this skill",
      "apply this skill",
      "install a skill",
      "download a skill",
      "import a skill",
      "what does this skill do",
      "how do I use this skill",
      "skill execution",
      "execute this skill"
    ],
    "minScore": 4
  },
  "categories": [
    "skills",
    "meta",
    "workflow"
  ],
  "requiredTools": [
    "skill_list",
    "skill_read",
    "skill_inspect",
    "skill_create",
    "skill_create_bundle",
    "skill_import_bundle",
    "skill_export_bundle",
    "skill_update_from_source",
    "skill_manifest_write",
    "skill_resource_list",
    "skill_resource_read",
    "skill_resource_write",
    "skill_resource_delete",
    "skill_update_metadata",
    "skill_repair_metadata",
    "skill_audit_all",
    "skill_candidate_submit",
    "skill_curator"
  ],
  "permissions": {
    "workspaceRead": true,
    "workspaceWrite": true,
    "shell": true
  },
  "resources": [
    {
      "path": "references/evaluation-loop.md",
      "type": "doc",
      "description": "Compact guidance for routing tests, baseline comparisons, objective assertions, qualitative review, and variance analysis."
    }
  ],
  "implicitInvocation": false,
  "lifecycle": "active"
}
