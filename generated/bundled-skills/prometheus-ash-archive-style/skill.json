  "visibility": "public",
  "version": "2.0.0",
  "entrypoint": "SKILL.md",
  "triggers": [
    "prometheus one style",
    "prometheus brand visuals",
    "prometheus visual direction",
    "black and gold prometheus",
    "prometheus promo video style",
    "ash and archive style",
    "make it less ai-looking"
  ],
  "categories": [
    "creative",
    "brand",
    "video",
    "hyperframes",
    "motion-design",
    "prometheus"
  ],
  "requiredTools": [
    "workspace_write",
    "creative_quality"
  ],
  "implicitInvocation": false,
  "permissions": {
    "workspaceRead": true,
    "workspaceWrite": true
  },
  "resources": [
