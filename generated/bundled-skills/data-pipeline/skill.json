{
  "schemaVersion": "prometheus-skill-bundle-v1",
  "entrypoint": "SKILL.md",
  "visibility": "public",
  "description": "Process, clean, transform, merge, validate, deduplicate, aggregate, convert, or export CSV, JSON, JSONL, Excel, logs, and other datasets. Use for repeatable ETL-style file workflows, especially when data quality and output verification matter.",
  "triggers": [
    "clean this dataset",
    "api to database",
    "import export workflow",
    "scheduled data job",
    "automate data flow",
    "data job retry",
    "pipeline architecture",
    "normalize dataset",
    "batch processing",
    "pipeline failed",
    "sync records",
    "csv pipeline"
  ],
  "categories": [
    "data",
    "automation",
    "etl",
    "engineering"
  ],
  "requiredTools": [
    "workspace_write",
    "web_search"
  ],
  "lifecycle": "active",
  "name": "data-pipeline",
  "id": "data-pipeline",
  "implicitInvocation": true,
  "triggerPolicy": {
    "version": 2,
    "rules": [
      {
        "allOf": [
          "csv"
        ],
        "anyOf": [
          "clean",
          "merge",
          "dedupe",
          "deduplicate",
          "transform",
          "convert"
        ]
      },
      {
        "allOf": [
          "csvs"
        ],
        "anyOf": [
          "clean",
          "merge",
          "dedupe",
          "deduplicate",
          "transform",
          "convert",
          "combine"
        ]
      },
      {
        "allOf": [
          "json"
        ],
        "anyOf": [
          "convert",
          "transform",
          "flatten",
          "merge"
        ]
      },
      {
        "allOf": [
          "dataset"
        ],
        "anyOf": [
          "clean",
          "merge",
          "dedupe",
          "deduplicate",
          "aggregate"
        ]
      }
    ]
  }
}
