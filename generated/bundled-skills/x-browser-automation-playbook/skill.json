{
  "schemaVersion": "prometheus-skill-bundle-v1",
  "id": "x-browser-automation-playbook",
  "name": "x-browser-automation-playbook",
  "description": "Operate X/Twitter interactively in an authenticated browser session: search, navigate, post, reply, like, inspect bookmarks, and recover from X-specific UI state. Use only when the user requests live X interaction; use x-post-fetch-and-media for reading a known post and general browser automation for non-X sites.",
  "visibility": "public",
  "version": "2.6.0",
  "entrypoint": "SKILL.md",
  "triggers": [
    "upload media to x",
    "post this on x",
    "scroll collect benchmark",
    "web_fetch vs scroll_collect",
    "x extraction latency",
    "bookmark this tweet",
    "fill tweet composer",
    "inspect x profile",
    "schedule a tweet",
    "benchmark x urls",
    "like this tweet",
    "draft a tweet"
  ],
  "categories": [
    "browser",
    "social",
    "x",
    "twitter",
    "automation"
  ],
  "requiredTools": [
    "browser_automation",
    "web_search",
    "web_fetch"
  ],
  "implicitInvocation": true,
  "permissions": {
    "workspaceRead": true,
    "workspaceWrite": true,
    "shell": false,
    "externalSideEffects": false
  },
  "resources": [
    {
      "path": "examples/chrome-debug-port-retry-blocker.md",
      "type": "example",
      "description": "Troubleshooting example for X browser automation when Chrome debug profile/port 9222 blocks first open attempts but a later explicit retry may succeed."
    },
    {
      "path": "examples/competitor-feature-scan-on-x.md",
      "type": "example",
      "description": "Read-only competitor feature scan workflow for X: collect latest competitor feature posts and translate them into Prometheus product implications, with snapshot-error fallback."
    },
    {
      "path": "examples/x-browser-open-timeout-no-session.md",
      "type": "example"
    },
    {
      "path": "references/background/x-media-transcription-workflow.md",
      "type": "doc"
    },
    {
      "path": "references/detailed-guide.md",
      "type": "reference"
    },
    {
      "path": "references/examples/composite-missing-and-chrome-debug-timeout.md",
      "type": "reference"
    },
    {
      "path": "references/no-em-dash-x-copy.md",
      "type": "doc",
      "description": "X content style rule for posts and replies"
    },
    {
      "path": "references/styles/x-browser-automation-playbook.md",
      "type": "doc",
      "description": "Add style pattern to x-browser-automation-playbook"
    },
    {
      "path": "references/workflows/x-browser-automation-playbook.md",
      "type": "doc",
      "description": "Add workflow recipe to x-browser-automation-playbook"
    },
    {
      "path": "references/workflows/x-bookmarks-corpus-audit.md",
      "type": "doc"
    }
  ]
}
