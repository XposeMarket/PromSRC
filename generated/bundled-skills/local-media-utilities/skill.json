{
  "schemaVersion": "prometheus-skill-bundle-v1",
  "id": "local-media-utilities",
  "name": "local-media-utilities",
  "description": "Inspect and transform local audio, video, and image files with Prometheus-bundled FFmpeg and FFprobe. Use for metadata inspection, audio extraction, frame capture, trimming, transcoding, resizing, compression, thumbnails, contact sheets, or other safe local media operations.",
  "visibility": "public",
  "version": "1.0.0",
  "entrypoint": "SKILL.md",
  "triggers": [
    "inspect media metadata",
    "local media utility",
    "capture video frame",
    "convert media file",
    "generate thumbnail",
    "ffprobe metadata",
    "audio extraction",
    "ffmpeg command",
    "extract audio",
    "media cli",
    "video conversion",
    "cut clip"
  ],
  "categories": [
    "prometheus",
    "media",
    "cli",
    "tooling"
  ],
  "requiredTools": [
    "workspace_write"
  ],
  "implicitInvocation": false,
  "permissions": {
    "workspaceRead": true,
    "workspaceWrite": true,
    "shell": true
  },
  "resources": [],
  "triggerPolicy": {
    "version": 2,
    "rules": [
      {
        "allOf": [
          "convert"
        ],
        "anyOf": [
          "mp4",
          "mp3",
          "wav",
          "video file",
          "audio file",
          "gif"
        ]
      },
      {
        "allOf": [
          "trim"
        ],
        "anyOf": [
          "video",
          "audio",
          "clip"
        ]
      },
      {
        "allOf": [
          "compress"
        ],
        "anyOf": [
          "video",
          "image",
          "audio"
        ]
      }
    ]
  }
}
