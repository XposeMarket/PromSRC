{
  "schemaVersion": "prometheus-skill-bundle-v1",
  "id": "spreadsheets",
  "name": "spreadsheets",
  "description": "Read, analyze, create, and edit XLSX, XLS, and CSV spreadsheet artifacts with SheetJS. Use when the task directly involves workbook sheets, tabular spreadsheet data, formulas, or an Excel-compatible deliverable; do not use for database queries or prose reports without a workbook.",
  "visibility": "public",
  "version": "1.1.0",
  "entrypoint": "SKILL.md",
  "triggers": [
    "check the spreadsheet formulas for errors",
    "create an excel workbook",
    "build an excel model",
    "analyze this excel file",
    "read this spreadsheet",
    "summarize this workbook",
    "export spreadsheet data",
    "edit this xlsx"
  ],
  "categories": [
    "spreadsheets",
    "xlsx",
    "csv"
  ],
  "requiredTools": [],
  "implicitInvocation": true,
  "permissions": {
    "workspaceRead": true,
    "workspaceWrite": true,
    "shell": false,
    "externalSideEffects": false
  },
  "resources": [
    {
      "path": "references/reading.md",
      "type": "reference"
    },
    {
      "path": "references/writing.md",
      "type": "reference"
    }
  ],
  "triggerPolicy": {
    "version": 2,
    "rules": [
      {
        "allOf": [
          "xlsx"
        ],
        "noneOf": [
          "desktop app"
        ]
      },
      {
        "allOf": [
          "spreadsheet"
        ],
        "anyOf": [
          "create",
          "edit",
          "analyze",
          "read",
          "make"
        ],
        "noneOf": [
          "desktop app"
        ]
      },
      {
        "allOf": [
          "excel"
        ],
        "anyOf": [
          "file",
          "sheet",
          "workbook",
          "formula"
        ],
        "noneOf": [
          "desktop app"
        ]
      }
    ]
  }
}
