{
  "schemaVersion": "prometheus-skill-bundle-v1",
  "id": "brand-assets-and-logo-retrieval",
  "name": "Brand Assets and Logo Retrieval",
  "description": "Find, verify, download, normalize, and provenance-track existing official brand logos, icons, and wordmarks. Use when an authoritative asset must be sourced; use exact-logo-brand-kit-workflow to compose a supplied or sourced logo into a board or mockup, not to find the asset.",
  "version": "1.0.0",
  "entrypoint": "SKILL.md",
  "triggers": [
    "find the official logo",
    "find press kit assets",
    "get favicon and logo",
    "download brand assets",
    "brand asset provenance",
    "retrieve exact logo",
    "logo api fallback",
    "get company svg",
    "official wordmark"
  ],
  "categories": [
    "brand",
    "assets",
    "research",
    "design",
    "media"
  ],
  "requiredTools": [
    "web_search",
    "web_fetch",
    "media_assets",
    "workspace_write",
    "browser_automation"
  ],
  "implicitInvocation": true,
  "permissions": {
    "browser": true,
    "workspaceRead": true,
    "workspaceWrite": true,
    "externalSideEffects": false
  },
  "resources": [
    {
      "path": "references/source-priority.md",
      "type": "doc",
      "description": "Authority rules"
    },
    {
      "path": "references/trigger-tests.md",
      "type": "test",
      "description": "Routing tests"
    },
    {
      "path": "templates/asset-provenance.md",
      "type": "template",
      "description": "Provenance manifest"
    }
  ]
}
