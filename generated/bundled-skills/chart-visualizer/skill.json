{
  "schemaVersion": "prometheus-skill-bundle-v1",
  "id": "chart-visualizer",
  "name": "chart-visualizer",
  "description": "Render a live inline Chart.js chart in chat when the user asks to chart, graph, plot, or visualize numeric data, KPI trends, comparisons, distributions, or correlations. Use only for inline charts; do not save files or use this for dashboards, interactive apps, or presentation decks.",
  "visibility": "public",
  "version": "1.0.0",
  "entrypoint": "SKILL.md",
  "triggers": [
    "create a sales chart",
    "compare these numbers",
    "time series chart",
    "make a chart",
    "show a graph",
    "visualize the data",
    "plot this data",
    "financial chart",
    "dashboard chart",
    "radar chart",
    "graph this"
  ],
  "categories": [
    "charts",
    "visualization",
    "data"
  ],
  "requiredTools": [
    "show_ui_card"
  ],
  "implicitInvocation": true,
  "permissions": {
    "workspaceRead": true,
    "workspaceWrite": true,
    "shell": false,
    "externalSideEffects": false
  },
  "resources": [
    {
      "path": "references/config-examples.md",
      "type": "reference"
    }
  ],
  "triggerPolicy": {
    "version": 2,
    "rules": [
      {
        "allOf": [
          "chart"
        ],
        "anyOf": [
          "make",
          "plot",
          "create",
          "draw",
          "show",
          "this data"
        ],
        "noneOf": [
          "org chart",
          "flowchart",
          "seating chart"
        ]
      },
      {
        "allOf": [
          "graph"
        ],
        "anyOf": [
          "plot",
          "make",
          "show",
          "this data"
        ],
        "noneOf": [
          "knowledge graph",
          "graph database"
        ]
      },
      {
        "allOf": [
          "plot"
        ],
        "anyOf": [
          "data",
          "numbers",
          "trend",
          "values"
        ]
      }
    ]
  }
}
