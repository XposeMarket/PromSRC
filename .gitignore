# ============================================================
# Prometheus - .gitignore
# ============================================================

# --- DOCKER / ENV ---
.env
.env.*
!.env.example
!.env.*.example

# --- SECRETS & CONFIG (NEVER COMMIT) ---
.localclaw/config.json
.localclaw/credentials/
.localclaw/vault/
/.prometheus/
/.prometheus-dev-*/
/.prometheus-instances/
/.agents/
/.claude/
/Brain/

# --- RUNTIME DATA ---
.localclaw/sessions/
.localclaw/logs/
.localclaw/memory/
.localclaw/facts.json
.localclaw/self_learning.json
.localclaw/jobs.db
.localclaw/update_state.json
.localclaw/tasks/
.localclaw/jobs/
.localclaw/ocr-cache/
.localclaw/heartbeat/
.localclaw/task-heartbeat.json
.localclaw/cron/runs/

# --- DASHBOARD RUNTIME STATE ---
ai-dashboard/dashboard-state.json
ai-dashboard/dashboard-requests.json

# --- LOGS ---
gateway.log
gateway.err.log
*.log

# --- TEMP FILES ---
tmp_payload.json
mnt/
/.claude/settings.local.json
/.vscode/settings.json
/.npmrc
/.gateway-*.cjs
/.pip-cache/
/.pip-tmp/
/.tmp-py/
__pycache__/
*.pyc
.tmp_*
.tmp_*/
.tmp_openclaw_*/
.tmp_codex_*
tmp_*
fix_log_line.py

# --- LOCAL PLANNING / HANDOFF ARTIFACTS ---
/CIS.docx
/Prometheus_CIS_Plan.docx
/Prometheus_Teams_CIS_Master_Plan.docx
/prometheus_browser_intelligence.docx
/skills.zip
/Context.md
/PROPOSALS_ANALYSIS.md
/Prometheus_Teams_CIS_Master_Plan.md
/apply-local-llm-patch.js
/b5-server-v2.js
/write-chat-helpers.js
/patch-server-v2.js
/rebrand-html.js
/rebrand-src.js
/test-ollama.mjs
/check-build.bat
/start-gateway.bat
/HEARTBEAT.md
/PROMETHEUS_HTML_MOTION_BACKEND_HANDOFF.md
/PROMETHEUS_VIDEO_CREATIVE_UPGRADE_PLAN.md
/Prometheus_Team_Room_Refinement_Plan.md
/prometheus_creative_suite_plan.md
/hook-library.skill
/-Context
/*.docx
/*.mp4
/*.png
/eng.traineddata

# --- LOCAL BINARY / MODEL ARTIFACTS ---
/bin/ffmpeg/
*.onnx
*.gguf
*.safetensors

# --- RUNTIME FILES THAT MUST NEVER ENTER SOURCE ---
src/**/*.log
src/**/*.md.bak
src/**/memory/*.md

# --- NODE ---
node_modules/
/dist/
native/desktop-helper-macos/.build/
native/desktop-helper-windows/build/
bin/prometheus-desktop-helper.exe
*.js.map
/package/
*.tgz

# --- TEST ARTIFACTS ---
tests/.golden-progress.log

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- ELECTRON BUILD OUTPUT ---
/release/
/release-public/
/output/
/tmp/

# --- PERSONAL WORKSPACE (never tracked) ---
# workspace/ holds the owner's personal runtime data (memory, Brain, uploads,
# exports, games, reports, ...). This repository is public, so none of it is
# tracked. Only two subtrees are allowed:
#   workspace/skills/  shipped skill catalog (read by build + tests), minus its
#                      local edit history and caches
#   workspace/self/    developer self docs (read by scripts/test-*.mjs)
# Enforced by scripts/audit-repo-privacy.mjs via scripts/check-workspace-tracking.mjs.
/workspace/*
!/workspace/skills/
!/workspace/self/
/workspace/skills/.history/
/workspace/skills/.cache/
workspace/**/node_modules/
workspace/**/build/
workspace/**/logs/
workspace/**/*.log
workspace/**/*.cpuprofile
workspace/**/__pycache__/
workspace/**/*.pyc

# Local OSS reference checkouts at the repo root.
oss-agents/

# prom_repo_sync: auto-ignored exclude-matched noise
*.tmp
*.bak
*.mp4
*.mov
*.webm

# Skill safety-scan caches written next to connector skills at runtime
src/extensions/bundled/connectors/*/.cache/
generated/bundled-skills/.cache/
workspace/skills/.cache/

# Staged gateway Node runtime for packaged builds (scripts/prepare-bundled-node.js)
/build-resources/


# local eval output (published results live in evals/RESULTS.md)
evals/results/
