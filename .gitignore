# ============================================================
# Prometheus - .gitignore
# ============================================================

# --- DOCKER / ENV ---
.env

# --- SECRETS & CONFIG (NEVER COMMIT) ---
.localclaw/config.json
.localclaw/credentials/
.localclaw/vault/
/.prometheus/
/.prometheus-*/
/.agents/
/.claude/
/Brain/

# --- RUNTIME DATA ---
.localclaw/sessions/
.localclaw/logs/
.localclaw/memory/
.localclaw/facts.json
.localclaw/self_learning.json
.localclaw/jobs.db
.localclaw/update_state.json
.localclaw/tasks/
.localclaw/jobs/
.localclaw/ocr-cache/
.localclaw/heartbeat/
.localclaw/task-heartbeat.json
.localclaw/cron/runs/

# --- DASHBOARD RUNTIME STATE ---
ai-dashboard/dashboard-state.json
ai-dashboard/dashboard-requests.json

# --- LOGS ---
gateway.log
gateway.err.log
*.log

# --- TEMP FILES ---
tmp_payload.json
mnt/
/.claude/settings.local.json
/.vscode/settings.json
/.npmrc
/.gateway-*.cjs
/.pip-cache/
/.pip-tmp/
/.tmp-py/
__pycache__/
*.pyc
.tmp_*
.tmp_*/
.tmp_openclaw_*/
.tmp_codex_*
tmp_*
fix_log_line.py

# --- LOCAL PLANNING / HANDOFF ARTIFACTS ---
/CIS.docx
/Prometheus_CIS_Plan.docx
/Prometheus_Teams_CIS_Master_Plan.docx
/prometheus_browser_intelligence.docx
/skills.zip
/Context.md
/PROPOSALS_ANALYSIS.md
/Prometheus_Teams_CIS_Master_Plan.md
/apply-local-llm-patch.js
/b5-server-v2.js
/write-chat-helpers.js
/patch-server-v2.js
/rebrand-html.js
/rebrand-src.js
/test-ollama.mjs
/check-build.bat
/start-gateway.bat
/HEARTBEAT.md
/PROMETHEUS_HTML_MOTION_BACKEND_HANDOFF.md
/PROMETHEUS_VIDEO_CREATIVE_UPGRADE_PLAN.md
/Prometheus_Team_Room_Refinement_Plan.md
/prometheus_creative_suite_plan.md
/hook-library.skill
/-Context
/*.docx
/*.mp4
/*.png
/eng.traineddata

# --- LOCAL BINARY / MODEL ARTIFACTS ---
/bin/ffmpeg/
*.onnx
*.gguf
*.safetensors

# --- RUNTIME FILES THAT MUST NEVER ENTER SOURCE ---
src/**/*.log
src/**/*.md.bak
src/**/memory/*.md

# --- NODE ---
node_modules/
/dist/
native/desktop-helper-macos/.build/
native/desktop-helper-windows/build/
bin/prometheus-desktop-helper.exe
*.js.map
/package/
*.tgz

# --- TEST ARTIFACTS ---
tests/.golden-progress.log

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- ELECTRON BUILD OUTPUT ---
/release/
/release-public/
/output/
/tmp/

# --- PERSONAL / MACHINE-LOCAL PROMETHEUS DATA ---
# Source control contains application code, tests, fixtures, and deliberate
# checked-in assets only. Live workspace content, chats, memories, observations,
# generated media, project state, audit snapshots, downloads, uploads, task
# journals, subagent state, and other machine-local records stay on the machine.
#
# IMPORTANT: ignore rules do not untrack files already present in Git history.
# Run scripts/migrate-local-data-out-of-repo.mjs before the separate tracked-data
# purge so a later pull can never destroy the user's only local copy.
/workspace/

# External reference checkouts / local clones
/oss-agents/

# Common generated noise anywhere outside workspace as an additional guard.
*.tmp
*.bak
*.mp4
*.mov
*.webm
*.cpuprofile
*.obj
**/__pycache__/
**/*.pyc
