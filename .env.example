# ============================================================
# Prometheus – environment variables
# Copy this file to .env and customise it.
# docker-compose.yml reads these automatically.
# ============================================================

# ── Active provider ─────────────────────────────────────────
# One of: ollama | lm_studio | llama_cpp | openai | openai_codex | xai
PROMETHEUS_PROVIDER=ollama

# ── Port ────────────────────────────────────────────────────
# Port the Prometheus gateway will be accessible on the HOST
# The app internally always runs on 18789 inside the container.
# Change HOST_PORT to map it to a different port on your machine.
HOST_PORT=18789

# ── Ollama (default) ────────────────────────────────────────
# Model to auto-pull on first run (only used when PROVIDER=ollama)
PROMETHEUS_DEFAULT_MODEL=qwen3:4b
# Ollama endpoint (leave as-is when using the bundled ollama container)
# Change to http://host.docker.internal:11434 to use Ollama on your host machine
OLLAMA_HOST=http://ollama:11434

# Memory embeddings
# Prometheus automatically uses saved OpenAI credentials (API key or OAuth)
# for memory embeddings when connected, then tries local providers, then hash.
# Set to hash to disable real embedding backfills, or to a provider id to force one.
PROMETHEUS_MEMORY_EMBEDDING_PROVIDER=auto
PROMETHEUS_MEMORY_AUTO_EMBEDDINGS=1
PROMETHEUS_MEMORY_AUTO_EMBEDDING_LIMIT=250
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ── LM Studio ───────────────────────────────────────────────
# LM Studio runs on the HOST, not inside Docker.
# Use host.docker.internal to reach it from inside the container.
LM_STUDIO_ENDPOINT=http://host.docker.internal:1234
# LM_STUDIO_API_KEY=          # optional – only if you enabled auth in LM Studio
# LM_STUDIO_MODEL=            # e.g. mistral-nemo-instruct-2407

# ── llama.cpp ───────────────────────────────────────────────
# llama.cpp server also runs on the HOST.
LLAMA_CPP_ENDPOINT=http://host.docker.internal:8080
# LLAMA_CPP_MODEL=            # e.g. Meta-Llama-3-8B-Instruct.Q4_K_M.gguf

# ── OpenAI (API key) ────────────────────────────────────────
OPENAI_API_KEY=
# Realtime voice auth: auto prefers the local Codex ChatGPT OAuth app-server
# bridge; codex_oauth makes that path strict; api_key disables the bridge.
# PROMETHEUS_OPENAI_REALTIME_AUTH_MODE=auto
# OPENAI_MODEL=gpt-4o
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── OpenAI Codex (OAuth / ChatGPT Plus) ─────────────────────
# No key needed – Prometheus handles the OAuth flow.
# Mount your .prometheus dir (see docker-compose.yml) so tokens persist.
# CODEX_MODEL=gpt-5.5

# Coding-context packet V3 (normally configured through work_context in config.json)
# PROMETHEUS_CODING_CONTEXT_PACKET_V3=1
# PROMETHEUS_CODING_CONTEXT_PACKET_STORE=

# xAI / Grok
XAI_API_KEY=
# XAI_MODEL=grok-4.20-reasoning
# XAI_IMAGE_MODEL=grok-imagine-image-quality
# XAI_IMAGE_RESOLUTION=1k
# XAI_VIDEO_MODEL=grok-imagine-video
# XAI_VIDEO_RESOLUTION=480p

# Background desktop automation
# Optional future HTTP/WebSocket worker endpoint for an isolated VM/RDP/Sandbox desktop.
# Leave empty to use the local Windows Sandbox folder bridge tools.
# PROMETHEUS_DESKTOP_WORKER_URL=
# Lease-managed target lifecycle (default: local Windows Sandbox, on demand).
# PROMETHEUS_DESKTOP_TARGET_MODE=sandbox
# PROMETHEUS_DESKTOP_IDLE_TIMEOUT_MS=600000
# PROMETHEUS_DESKTOP_START_TIMEOUT_MS=120000
# PROMETHEUS_DESKTOP_STOP_GRACE_MS=8000
# PROMETHEUS_DESKTOP_STOP_FORCE_MS=8000
# Explicit opt-in only; keeps an owned target warm after release.
# PROMETHEUS_DESKTOP_WARM_MODE=0
# Opt-in Hyper-V control boundary; command transport must be configured separately.
# PROMETHEUS_DESKTOP_VM_NAME=Prometheus-Desktop
# PROMETHEUS_DESKTOP_VM_REQUIRE_IP=1
# PROMETHEUS_DESKTOP_VM_READY_URL=
