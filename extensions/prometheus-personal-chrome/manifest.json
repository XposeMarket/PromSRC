{
  "manifest_version": 3,
  "name": "Prometheus Personal Chrome",
  "version": "1.2.0",
  "description": "Locally paired automation bridge for Prometheus. It never opens a remote debugging port.",
  "permissions": [
    "debugger",
    "tabs",
    "windows",
    "downloads",
    "storage",
    "alarms",
    "cookies"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Prometheus Personal Chrome"
  }
}
