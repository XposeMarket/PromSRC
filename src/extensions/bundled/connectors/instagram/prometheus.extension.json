{
  "id": "instagram",
  "kind": "connector",
  "name": "Instagram",
  "description": "Connect Instagram through the Prometheus browser session for analytics, engagement, and social coaching workflows.",
  "category": "Social",
  "enabledByDefault": true,
  "docsUrl": "https://www.instagram.com/",
  "tags": ["instagram", "social", "browser session"],
  "runtime": {
    "binding": "gateway/connections/browser-session:instagram",
    "entrypoint": "./runtime.js"
  },
  "ui": {
    "color": "#E1306C",
    "permissions": [
      { "icon": "[]", "label": "Read posts, reels, and stories analytics" },
      { "icon": "=", "label": "Read reach, impressions, and engagement" },
      { "icon": "@", "label": "Read follower count and growth trends" },
      { "icon": "#", "label": "Read comments on your posts" }
    ]
  },
  "ownership": {
    "toolNamespaces": ["connector_instagram"],
    "tools": ["connector_instagram_api_request"],
    "capabilities": ["social", "analytics", "browser_session"]
  },
  "setup": {
    "authType": "browser_session",
    "statusMode": "generic",
    "docsHint": "Browser login does not authorize the API. API tools require an Instagram Login access_token saved in secure credentials or INSTAGRAM_ACCESS_TOKEN; refresh externally when expired.",
    "fields": [{ "key": "access_token", "label": "Optional Instagram API access token", "input": "password", "secret": true, "required": false }],
    "browserLogin": {
      "url": "https://www.instagram.com/accounts/login/",
      "checkUrl": "https://www.instagram.com/"
    }
  }
}
