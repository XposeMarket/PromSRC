{
  "id": "vercel",
  "kind": "connector",
  "name": "Vercel",
  "description": "Connect Vercel so Prometheus can inspect project Git links, create source-aware deployments, diagnose builds, manage hosting resources, and call the provider API with approval-aware writes.",
  "category": "Dev",
  "enabledByDefault": true,
  "docsUrl": "https://vercel.com/account/tokens",
  "tags": ["vercel", "deployments", "git", "hosting", "api key"],
  "activation": {
    "aliases": ["deploy", "deployment", "preview", "production", "environment", "env", "project", "projects", "vercel", "build logs", "git deployment"]
  },
  "runtime": {
    "binding": "integrations/connectors/vercel",
    "entrypoint": "./runtime.js"
  },
  "ui": {
    "color": "#111111",
    "permissions": [
      { "icon": "^", "label": "Inspect and manage Vercel projects and Git-linked settings" },
      { "icon": "->", "label": "Create deployments from a Git branch or commit and inspect build events" },
      { "icon": "?", "label": "Read deployment state, logs, aliases, domains, and live URLs" },
      { "icon": "!", "label": "Write operations require the normal Prometheus approval gate" }
    ]
  },
  "ownership": {
    "toolNamespaces": ["connector_vercel"],
    "capabilities": ["api", "deployments", "hosting", "projects", "git", "environment", "domains", "aliases"],
    "tools": [
      "connector_vercel_status",
      "connector_vercel_list_teams",
      "connector_vercel_list_projects",
      "connector_vercel_get_project",
      "connector_vercel_create_project",
      "connector_vercel_update_project",
      "connector_vercel_delete_project",
      "connector_vercel_list_deployments",
      "connector_vercel_get_deployment",
      "connector_vercel_create_deployment",
      "connector_vercel_redeploy",
      "connector_vercel_deployment_events",
      "connector_vercel_cancel_deployment",
      "connector_vercel_delete_deployment",
      "connector_vercel_list_aliases",
      "connector_vercel_assign_alias",
      "connector_vercel_env",
      "connector_vercel_domains",
      "connector_vercel_get_project_domain",
      "connector_vercel_manage_project_domain",
      "connector_vercel_api_request"
    ]
  },
  "setup": {
    "authType": "api_key",
    "statusMode": "generic",
    "docsUrl": "https://vercel.com/account/tokens",
    "docsHint": "Vercel -> Account Settings -> Tokens. Project ID is optional; omit it for account/team-wide tools. Team ID is optional and scopes team-owned resources.",
    "fields": [
      {
        "key": "apiKey",
        "label": "API Token",
        "input": "password",
        "required": true,
        "secret": true,
        "placeholder": "vercel_pat_..."
      },
      {
        "key": "projectId",
        "label": "Project ID",
        "input": "text",
        "required": false,
        "placeholder": "prj_..."
      },
      {
        "key": "teamId",
        "label": "Team ID",
        "input": "text",
        "required": false,
        "placeholder": "team_..."
      }
    ]
  }
}
