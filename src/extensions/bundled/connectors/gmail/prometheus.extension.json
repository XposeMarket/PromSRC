{
  "id": "gmail",
  "kind": "connector",
  "name": "Gmail",
  "description": "Connect Gmail so Prometheus can read inbox threads, draft replies, send email, and work with attachments.",
  "category": "Email",
  "enabledByDefault": true,
  "docsUrl": "https://console.cloud.google.com/",
  "tags": [
    "google",
    "email",
    "oauth"
  ],
  "runtime": {
    "binding": "integrations/connectors/gmail",
    "entrypoint": "./runtime.js"
  },
  "ui": {
    "color": "#EA4335",
    "permissions": [
      {
        "icon": "@",
        "label": "Read inbox and thread history"
      },
      {
        "icon": "->",
        "label": "Draft and send emails with approval"
      },
      {
        "icon": "?",
        "label": "Search emails by sender, subject, or keyword"
      },
      {
        "icon": "[]",
        "label": "Read and download attachments"
      }
    ]
  },
  "ownership": {
    "toolNamespaces": [
      "connector_gmail"
    ],
    "capabilities": [
      "email",
      "inbox",
      "attachments"
    ],
    "tools": [
      "connector_gmail_list_emails",
      "connector_gmail_get_email",
      "connector_gmail_prepare_email",
      "connector_gmail_send_email",
      "connector_gmail_get_profile",
      "connector_gmail_list_labels"
    ]
  },
  "setup": {
    "authType": "oauth",
    "statusMode": "oauth_connector",
    "docsUrl": "https://console.cloud.google.com/",
    "docsHint": "Google Cloud Console -> Enable Gmail API -> OAuth 2.0 credentials -> Desktop app.",
    "callback": {
      "port": 19420,
      "path": "/auth/callback/gmail"
    },
    "fields": [
      {
        "key": "clientId",
        "label": "Client ID",
        "input": "text",
        "required": true,
        "placeholder": "123456789-abc.apps.googleusercontent.com"
      },
      {
        "key": "clientSecret",
        "label": "Client Secret",
        "input": "password",
        "required": true,
        "secret": true,
        "placeholder": "GOCSPX-..."
      }
    ]
  },
  "connection": {
    "schemaVersion": 1,
    "aliases": ["Google Mail", "Gmail OAuth"],
    "domains": ["gmail.googleapis.com", "googleapis.com", "accounts.google.com"],
    "providerApp": {
      "provider": "google",
      "appType": "confidential-client",
      "clientIdEnv": "GMAIL_CLIENT_ID",
      "clientSecretEnv": "GMAIL_CLIENT_SECRET",
      "externalSetupRequired": true
    },
    "strategies": [{
      "id": "gmail-oauth",
      "adapter": "connector-oauth",
      "priority": 110,
      "capabilities": ["email.read", "inbox.read", "attachments.read"],
      "readOnlyDefault": true,
      "authentication": {
        "type": "oauth2",
        "scopes": ["https://www.googleapis.com/auth/gmail.readonly", "https://www.googleapis.com/auth/userinfo.email", "openid"],
        "authorizationUrl": "https://accounts.google.com/o/oauth2/v2/auth",
        "tokenUrl": "https://oauth2.googleapis.com/token",
        "pkceRequired": false,
        "nonceRequired": true,
        "callback": { "host": "localhost", "port": 19420, "path": "/auth/callback/gmail" },
        "clientIdEnv": "GMAIL_CLIENT_ID",
        "clientSecretEnv": "GMAIL_CLIENT_SECRET"
      },
      "verification": ["oauth.authentication", "account.identity", "resource.scope", "safe-read"],
      "config": { "provider": "google", "connectorId": "gmail", "resourceScope": "Google account" }
    }],
    "requestedCapabilities": [
      { "id": "email.read", "label": "Read email", "description": "Read inbox messages and thread content.", "risk": "read" },
      { "id": "inbox.read", "label": "Search inbox", "description": "Search messages and labels.", "risk": "read" },
      { "id": "attachments.read", "label": "Read attachments", "description": "Read attachment metadata and message content.", "risk": "read" },
      { "id": "email.send", "label": "Send email", "description": "Sending email is an explicit external write.", "risk": "write" },
      { "id": "email.modify", "label": "Modify mailbox", "description": "Mailbox changes require explicit approval and a separate scope grant.", "risk": "write" }
    ],
    "verification": ["oauth.authentication", "account.identity", "resource.scope", "safe-read"],
    "toolPolicy": { "defaultExposure": "read-only", "unknownTools": "blocked" }
  }
}
