{
  "id": "google_drive",
  "kind": "connector",
  "name": "Google Drive",
  "description": "Connect Google Drive so Prometheus can read files, docs, folders, and spreadsheets across your workspace.",
  "category": "Storage",
  "enabledByDefault": true,
  "docsUrl": "https://console.cloud.google.com/",
  "tags": [
    "google drive",
    "storage",
    "oauth"
  ],
  "runtime": {
    "binding": "integrations/connectors/google-drive",
    "entrypoint": "./runtime.js"
  },
  "ui": {
    "color": "#0F9D58",
    "permissions": [
      {
        "icon": "[]",
        "label": "Read files, folders, and docs"
      },
      {
        "icon": "+",
        "label": "Create and update files with approval"
      },
      {
        "icon": "?",
        "label": "Search across Drive"
      }
    ]
  },
  "ownership": {
    "toolNamespaces": [
      "connector_gdrive"
    ],
    "capabilities": [
      "documents",
      "storage",
      "files"
    ],
    "tools": [
      "connector_gdrive_list_files",
      "connector_gdrive_get_file",
      "connector_gdrive_read_file",
      "connector_gdrive_search"
    ]
  },
  "setup": {
    "authType": "oauth",
    "statusMode": "oauth_connector",
    "docsUrl": "https://console.cloud.google.com/",
    "docsHint": "Google Cloud Console -> Enable Drive API -> Use the same desktop OAuth credentials as Gmail if desired.",
    "callback": {
      "port": 19425,
        "path": "/auth/callback/google-drive"
    },
    "fields": [
      {
        "key": "clientId",
        "label": "Client ID",
        "input": "text",
        "required": true,
        "placeholder": "123456789-abc.apps.googleusercontent.com"
      },
      {
        "key": "clientSecret",
        "label": "Client Secret",
        "input": "password",
        "required": true,
        "secret": true,
        "placeholder": "GOCSPX-..."
      }
    ]
  },
  "connection": {
    "schemaVersion": 1,
    "aliases": ["GDrive", "Google Drive OAuth"],
    "domains": ["drive.googleapis.com", "googleapis.com", "accounts.google.com"],
    "providerApp": {
      "provider": "google",
      "appType": "confidential-client",
      "clientIdEnv": "GDRIVE_CLIENT_ID",
      "clientSecretEnv": "GDRIVE_CLIENT_SECRET",
      "externalSetupRequired": true
    },
    "strategies": [{
      "id": "google-drive-oauth",
      "adapter": "connector-oauth",
      "priority": 110,
      "capabilities": ["files.read", "search.read"],
      "readOnlyDefault": true,
      "authentication": {
        "type": "oauth2",
        "scopes": ["https://www.googleapis.com/auth/drive.readonly", "https://www.googleapis.com/auth/userinfo.email", "openid"],
        "authorizationUrl": "https://accounts.google.com/o/oauth2/v2/auth",
        "tokenUrl": "https://oauth2.googleapis.com/token",
        "pkceRequired": false,
        "nonceRequired": true,
        "callback": { "host": "localhost", "port": 19425, "path": "/auth/callback/google-drive" },
        "clientIdEnv": "GDRIVE_CLIENT_ID",
        "clientSecretEnv": "GDRIVE_CLIENT_SECRET"
      },
      "verification": ["oauth.authentication", "account.identity", "resource.scope", "safe-read"],
      "config": { "provider": "google", "connectorId": "google_drive", "resourceScope": "Google account and accessible files" }
    }],
    "requestedCapabilities": [
      { "id": "files.read", "label": "Read files and documents", "description": "Read file metadata and text content.", "risk": "read" },
      { "id": "search.read", "label": "Search Drive", "description": "Search files and folders in the connected account.", "risk": "read" },
      { "id": "files.write", "label": "Create or update files", "description": "File mutations require explicit approval and a separate scope grant.", "risk": "write" }
    ],
    "verification": ["oauth.authentication", "account.identity", "resource.scope", "safe-read"],
    "toolPolicy": { "defaultExposure": "read-only", "unknownTools": "blocked" }
  }
}
