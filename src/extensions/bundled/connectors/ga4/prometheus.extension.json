{
  "id": "ga4",
  "kind": "connector",
  "name": "Google Analytics 4",
  "description": "Connect GA4 so Prometheus can pull traffic, conversions, realtime usage, and report data.",
  "category": "Analytics",
  "enabledByDefault": true,
  "docsUrl": "https://console.cloud.google.com/",
  "tags": ["ga4", "analytics", "oauth"],
  "runtime": {
    "binding": "integrations/connectors/google-analytics",
    "entrypoint": "./runtime.js"
  },
  "ui": {
    "color": "#F59E0B",
    "permissions": [
      { "icon": "=", "label": "Read sessions, pageviews, and conversions" },
      { "icon": "?", "label": "Query custom reports and events" },
      { "icon": "!", "label": "Read-only analytics access" }
    ]
  },
  "ownership": {
    "toolNamespaces": ["connector_ga4"],
    "capabilities": ["analytics", "traffic", "reports"],
    "tools": [
      "connector_ga4_run_report",
      "connector_ga4_realtime_users",
      "connector_ga4_list_properties"
    ]
  },
  "setup": {
    "authType": "oauth",
    "statusMode": "oauth_connector",
    "docsUrl": "https://console.cloud.google.com/",
    "docsHint": "Google Cloud Console -> Enable Analytics Data API -> Desktop app credentials. Property selection is verified after sign-in; the legacy property field remains an advanced runtime override.",
    "callback": {
      "port": 19429,
      "path": "/auth/callback/ga4"
    },
    "fields": [
      {
        "key": "clientId",
        "label": "Client ID",
        "input": "text",
        "required": true,
        "placeholder": "123456789-abc.apps.googleusercontent.com"
      },
      {
        "key": "clientSecret",
        "label": "Client Secret",
        "input": "password",
        "required": true,
        "secret": true,
        "placeholder": "GOCSPX-..."
      }
    ]
  },
  "connection": {
    "schemaVersion": 1,
    "aliases": ["Google Analytics", "GA4 OAuth"],
    "domains": ["analyticsdata.googleapis.com", "analyticsadmin.googleapis.com", "accounts.google.com"],
    "providerApp": {
      "provider": "google",
      "appType": "confidential-client",
      "clientIdEnv": "GA4_CLIENT_ID",
      "clientSecretEnv": "GA4_CLIENT_SECRET",
      "externalSetupRequired": true
    },
    "strategies": [{
      "id": "ga4-oauth",
      "adapter": "connector-oauth",
      "priority": 110,
      "capabilities": ["analytics.read", "reports.read", "properties.read"],
      "readOnlyDefault": true,
      "authentication": {
        "type": "oauth2",
        "scopes": ["https://www.googleapis.com/auth/analytics.readonly", "https://www.googleapis.com/auth/userinfo.email", "openid"],
        "authorizationUrl": "https://accounts.google.com/o/oauth2/v2/auth",
        "tokenUrl": "https://oauth2.googleapis.com/token",
        "pkceRequired": false,
        "nonceRequired": true,
        "callback": { "host": "localhost", "port": 19429, "path": "/auth/callback/ga4" },
        "clientIdEnv": "GA4_CLIENT_ID",
        "clientSecretEnv": "GA4_CLIENT_SECRET"
      },
      "verification": ["oauth.authentication", "account.identity", "resource.scope", "safe-read"],
      "config": { "provider": "google", "connectorId": "ga4", "resourceScope": "GA4 properties returned after sign-in" }
    }],
    "requestedCapabilities": [
      { "id": "analytics.read", "label": "Read analytics", "description": "Read traffic, conversions, and audience metrics.", "risk": "read" },
      { "id": "reports.read", "label": "Run reports", "description": "Run read-only Analytics Data API reports.", "risk": "read" },
      { "id": "properties.read", "label": "Select GA4 properties", "description": "Associate the connection with accessible GA4 property identities.", "risk": "read" }
    ],
    "verification": ["oauth.authentication", "account.identity", "resource.scope", "safe-read"],
    "toolPolicy": { "defaultExposure": "read-only", "unknownTools": "blocked" }
  }
}
