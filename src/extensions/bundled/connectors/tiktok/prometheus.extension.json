{
  "id": "tiktok",
  "kind": "connector",
  "name": "TikTok",
  "description": "Connect TikTok through the Prometheus browser session for performance, audience, and trend analysis.",
  "category": "Social",
  "enabledByDefault": true,
  "docsUrl": "https://www.tiktok.com/",
  "tags": ["tiktok", "social", "browser session"],
  "runtime": {
    "binding": "gateway/connections/browser-session:tiktok",
    "entrypoint": "./runtime.js"
  },
  "ui": {
    "color": "#010101",
    "permissions": [
      { "icon": "[]", "label": "Read video views, watch time, and shares" },
      { "icon": "=", "label": "Read follower growth and profile analytics" },
      { "icon": "#", "label": "Read hashtag and sound performance" }
    ]
  },
  "ownership": {
    "toolNamespaces": ["connector_tiktok"],
    "tools": ["connector_tiktok_api_request"],
    "capabilities": ["social", "analytics", "browser_session"]
  },
  "setup": {
    "authType": "browser_session",
    "statusMode": "generic",
    "docsHint": "Browser login does not authorize the API. API tools require a provider access_token saved in secure credentials or TIKTOK_ACCESS_TOKEN; refresh externally when expired.",
    "fields": [{ "key": "access_token", "label": "Optional TikTok API access token", "input": "password", "secret": true, "required": false }],
    "browserLogin": {
      "url": "https://www.tiktok.com/login",
      "checkUrl": "https://www.tiktok.com/"
    }
  }
}
