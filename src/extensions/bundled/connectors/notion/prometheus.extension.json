{
  "id": "notion",
  "kind": "connector",
  "name": "Notion",
  "description": "Connect Notion so Prometheus can read pages, databases, and workspace documents.",
  "category": "Docs",
  "enabledByDefault": true,
  "docsUrl": "https://www.notion.so/my-integrations",
  "tags": [
    "notion",
    "docs",
    "oauth"
  ],
  "runtime": {
    "binding": "integrations/connectors/notion",
    "entrypoint": "./runtime.js"
  },
  "ui": {
    "color": "#000000",
    "permissions": [
      {
        "icon": "[]",
        "label": "Read pages, databases, and blocks"
      },
      {
        "icon": "+",
        "label": "Create and update pages with approval"
      },
      {
        "icon": "?",
        "label": "Search across the workspace"
      }
    ]
  },
  "ownership": {
    "toolNamespaces": [
      "connector_notion"
    ],
    "capabilities": [
      "documents",
      "knowledge_base"
    ],
    "tools": [
      "connector_notion_search",
      "connector_notion_get_page",
      "connector_notion_create_page",
      "connector_notion_query_database",
      "connector_notion_append_content",
      "connector_notion_update_page",
      "connector_notion_create_database_entry",
      "connector_notion_add_comment",
      "connector_notion_list_comments",
      "connector_notion_api_request"
    ]
  },
  "setup": {
    "authType": "oauth",
    "statusMode": "oauth_connector",
    "docsUrl": "https://www.notion.so/my-integrations",
    "docsHint": "Fastest: notion.so/profile/integrations -> New integration (Internal) -> copy the Internal Integration Secret and paste it below, then share pages with the integration (page ... menu -> Connections). Or create a Public integration with Redirect URI http://localhost:19423/auth/callback/notion and use Client ID + Secret.",
    "callback": {
      "port": 19423,
      "path": "/auth/callback/notion"
    },
    "fields": [
      {
        "key": "accessToken",
        "label": "Internal Integration Secret",
        "input": "password",
        "required": false,
        "secret": true,
        "placeholder": "ntn_...",
        "help": "Paste this alone to connect immediately (no OAuth app needed)."
      },
      {
        "key": "clientId",
        "label": "Public integration Client ID",
        "input": "text",
        "required": false,
        "placeholder": "abc123..."
      },
      {
        "key": "clientSecret",
        "label": "Client Secret",
        "input": "password",
        "required": false,
        "secret": true,
        "placeholder": "secret_..."
      }
    ]
  },
  "connection": {
    "schemaVersion": 1,
    "aliases": ["Notion OAuth", "Notion workspace"],
    "domains": ["api.notion.com", "notion.so"],
    "providerApp": {
      "provider": "notion",
      "appType": "confidential-client",
      "clientIdEnv": "NOTION_CLIENT_ID",
      "clientSecretEnv": "NOTION_CLIENT_SECRET",
      "externalSetupRequired": true
    },
    "strategies": [{
      "id": "notion-oauth",
      "adapter": "connector-oauth",
      "priority": 110,
      "capabilities": ["pages.read", "databases.read", "search.read"],
      "readOnlyDefault": true,
      "authentication": {
        "type": "oauth2",
        "scopes": [],
        "authorizationUrl": "https://api.notion.com/v1/oauth/authorize",
        "tokenUrl": "https://api.notion.com/v1/oauth/token",
        "pkceRequired": false,
        "callback": { "host": "localhost", "port": 19423, "path": "/auth/callback/notion" },
        "clientIdEnv": "NOTION_CLIENT_ID",
        "clientSecretEnv": "NOTION_CLIENT_SECRET"
      },
      "verification": ["oauth.authentication", "account.identity", "resource.scope", "safe-read"],
      "config": { "provider": "notion", "connectorId": "notion", "resourceScope": "selected Notion workspace" }
    }],
    "requestedCapabilities": [
      { "id": "pages.read", "label": "Read pages", "description": "Read pages and their block content.", "risk": "read" },
      { "id": "databases.read", "label": "Read databases", "description": "Query databases shared with the connection.", "risk": "read" },
      { "id": "search.read", "label": "Search workspace", "description": "Search pages and databases in the selected workspace.", "risk": "read" },
      { "id": "pages.create", "label": "Create pages", "description": "Page creation is an explicit external write.", "risk": "write" }
    ],
    "verification": ["oauth.authentication", "account.identity", "resource.scope", "safe-read"],
    "toolPolicy": { "defaultExposure": "read-only", "unknownTools": "blocked" }
  }
}
