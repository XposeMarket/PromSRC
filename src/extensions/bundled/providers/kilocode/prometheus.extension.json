{
  "id": "kilocode",
  "kind": "provider",
  "name": "Kilo Gateway",
  "description": "Kilo AI Gateway for OpenAI-compatible access to hundreds of models and stable Auto routing tiers.",
  "category": "Gateway",
  "enabledByDefault": true,
  "docsUrl": "https://kilo.ai/docs/gateway",
  "tags": ["kilo", "kilocode", "gateway", "openai-compatible", "router"],
  "runtime": {
    "binding": "providers/openai-compat-adapter",
    "options": {
      "chatCompletionsPath": "/chat/completions",
      "modelsPath": "/models",
      "staticModels": ["kilo-auto/frontier", "kilo-auto/efficient", "kilo-auto/free"],
      "supportsLiveModelDiscovery": true
    }
  },
  "ui": {
    "color": "#16A34A"
  },
  "ownership": {
    "providerIds": ["kilocode"],
    "modelPrefixes": ["kilo-auto/", "anthropic/", "openai/", "google/", "deepseek/", "moonshotai/", "minimax/", "z-ai/"],
    "capabilities": ["llm", "api_key_auth", "openai_compat", "aggregator", "automatic_routing"]
  },
  "setup": {
    "authType": "api_key",
    "envVars": ["KILO_API_KEY", "KILOCODE_API_KEY"],
    "statusMode": "generic",
    "docsUrl": "https://kilo.ai/docs/gateway/authentication",
    "docsHint": "Kilo's current stable Auto IDs are kilo-auto/frontier, kilo-auto/efficient, and kilo-auto/free. The live /models endpoint remains authoritative for individual provider models.",
    "fields": [
      {
        "key": "api_key",
        "label": "API Key",
        "input": "password",
        "required": true,
        "secret": true,
        "placeholder": "Kilo API key"
      },
      {
        "key": "model",
        "label": "Model",
        "input": "text",
        "required": true,
        "placeholder": "kilo-auto/frontier"
      },
      {
        "key": "endpoint",
        "label": "Endpoint Override",
        "input": "text",
        "placeholder": "https://api.kilo.ai/api/gateway"
      }
    ]
  },
  "config": {
    "defaults": {
      "endpoint": "https://api.kilo.ai/api/gateway",
      "model": "kilo-auto/frontier"
    },
    "schema": {
      "api_key": "string",
      "endpoint": "string?",
      "model": "string"
    }
  }
}
