{
  "id": "gemini",
  "kind": "provider",
  "name": "Google Gemini",
  "description": "Google Gemini models through the official OpenAI-compatible Gemini API.",
  "category": "Hosted",
  "enabledByDefault": true,
  "docsUrl": "https://ai.google.dev/gemini-api/docs/openai",
  "tags": ["google", "gemini", "api", "openai-compatible"],
  "runtime": {
    "binding": "providers/gemini-adapter",
    "options": {
      "supportsLiveModelDiscovery": true,
      "supportsReasoningEffort": true
    }
  },
  "ui": {
    "color": "#2563EB"
  },
  "ownership": {
    "providerIds": ["gemini"],
    "modelPrefixes": ["gemini-"],
    "capabilities": ["llm", "api_key_auth", "openai_compat", "reasoning"]
  },
  "setup": {
    "authType": "api_key",
    "envVars": ["GEMINI_API_KEY", "GOOGLE_API_KEY"],
    "statusMode": "generic",
    "docsUrl": "https://aistudio.google.com/apikey",
    "docsHint": "Gemini 3 models support OpenAI-compatible chat completions and low/medium/high reasoning effort. Prometheus uses temperature 1.0 by default for Gemini 3, matching Google's current guidance.",
    "fields": [
      {
        "key": "api_key",
        "label": "API Key",
        "input": "password",
        "required": true,
        "secret": true,
        "placeholder": "AIza..."
      },
      {
        "key": "model",
        "label": "Model",
        "input": "text",
        "required": true,
        "placeholder": "gemini-3.7-flash"
      }
    ]
  },
  "config": {
    "defaults": {
      "model": "gemini-3.7-flash"
    },
    "schema": {
      "api_key": "string",
      "model": "string",
      "reasoning_effort": "none|low|medium|high?"
    },
    "uiHints": {
      "api_key": {
        "label": "API Key",
        "help": "Google AI Studio or Gemini API key. GEMINI_API_KEY and GOOGLE_API_KEY are also recognized."
      },
      "model": {
        "label": "Model",
        "help": "Default Gemini model. Live model discovery is used when available."
      }
    }
  }
}
