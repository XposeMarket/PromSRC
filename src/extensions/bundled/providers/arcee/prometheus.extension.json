{
  "id": "arcee",
  "kind": "provider",
  "name": "Arcee AI",
  "description": "Arcee AI hosted Trinity models through the official OpenAI-compatible API.",
  "category": "Hosted",
  "enabledByDefault": true,
  "docsUrl": "https://docs.arcee.ai/api-reference/your-first-api-call",
  "tags": ["arcee", "trinity", "openai-compatible"],
  "runtime": {
    "binding": "providers/openai-compat-adapter",
    "options": {
      "chatCompletionsPath": "/chat/completions",
      "modelsPath": "/models",
      "staticModels": ["trinity-mini"],
      "supportsLiveModelDiscovery": true
    }
  },
  "ui": {
    "color": "#9333EA"
  },
  "ownership": {
    "providerIds": ["arcee"],
    "modelPrefixes": ["trinity-", "arcee-ai/"],
    "capabilities": ["llm", "api_key_auth", "openai_compat", "tools"]
  },
  "setup": {
    "authType": "api_key",
    "envVars": ["ARCEEAI_API_KEY", "ARCEE_API_KEY"],
    "statusMode": "generic",
    "docsUrl": "https://docs.arcee.ai/api-reference/your-first-api-call",
    "docsHint": "Arcee's current direct API quickstart identifies trinity-mini as the production model. Live /models discovery is preferred over copying older third-party static catalogs.",
    "fields": [
      {
        "key": "api_key",
        "label": "API Key",
        "input": "password",
        "required": true,
        "secret": true,
        "placeholder": "Arcee API key"
      },
      {
        "key": "model",
        "label": "Model",
        "input": "text",
        "required": true,
        "placeholder": "trinity-mini"
      },
      {
        "key": "endpoint",
        "label": "Endpoint Override",
        "input": "text",
        "placeholder": "https://api.arcee.ai/api/v1"
      }
    ]
  },
  "config": {
    "defaults": {
      "endpoint": "https://api.arcee.ai/api/v1",
      "model": "trinity-mini"
    },
    "schema": {
      "api_key": "string",
      "endpoint": "string?",
      "model": "string"
    }
  }
}
